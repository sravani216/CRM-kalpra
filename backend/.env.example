# ==============================================================================
# Marketing CRM Backend Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Connection String for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketing_crm?schema=public"

# JWT Secret for future authentication token signing (Phase 2)
JWT_SECRET="crm-kalpra-super-secret-jwt-key-change-in-production"

