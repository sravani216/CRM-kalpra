// Prisma schema for Marketing CRM & Employee Work Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CEO
  ADMIN
  MANAGER
  EMPLOYEE
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  OVERDUE
  BLOCKED
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum ActivityType {
  CALL
  MEETING
  DISCUSSION
  STATUS_CHANGE
  NOTE
  PROPOSAL
  DEMO
  EMAIL
  FIELD_VISIT
}

enum NotificationType {
  LEAD_ASSIGNED
  TASK_ASSIGNED
  TASK_REVIEW
  TASK_APPROVED
  TASK_REJECTED
  FOLLOWUP_UPCOMING
  FOLLOWUP_OVERDUE
  STATUS_CHANGE
  ANNOUNCEMENT
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  role            Role             @default(EMPLOYEE)
  phone           String?
  avatar          String?
  designation     String?
  department      String?          @default("Marketing & Sales")
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  clientsCreated  Client[]         @relation("ClientsCreated")
  leadsCreated    Lead[]           @relation("LeadsCreated")
  assignedLeads   Lead[]           @relation("LeadsAssigned")
  assignmentsMade LeadAssignment[] @relation("AssignmentsMade")
  assignedToUser  LeadAssignment[] @relation("AssignedToUser")
  activities      LeadActivity[]
  tasksAssignedTo Task[]           @relation("TasksAssignedTo")
  tasksCreatedBy  Task[]           @relation("TasksCreatedBy")
  tasksReviewed   Task[]           @relation("TasksReviewed")
  taskUpdates     TaskUpdate[]
  followups       FollowUp[]
  dealsWon        Deal[]           @relation("DealsClosedBy")
  notifications   Notification[]
  auditLogs       AuditLog[]
  fieldCheckins   FieldCheckin[]

  @@map("users")
}

model Client {
  id              String         @id @default(uuid())
  clientId        String         @unique // e.g. CLT-1001
  name            String
  organization    String
  contactPerson   String
  phone           String
  email           String
  location        String
  industry        String
  requirement     String
  source          String         @default("Direct")
  notes           String?
  status          String         @default("Active")
  isDeleted       Boolean        @default(false)
  createdById     String
  createdBy       User           @relation("ClientsCreated", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  leads           Lead[]
  tasks           Task[]
  followups       FollowUp[]
  deals           Deal[]
  fieldCheckins   FieldCheckin[]

  @@index([phone])
  @@index([email])
  @@index([organization])
  @@map("clients")
}

model Lead {
  id                String           @id @default(uuid())
  leadId            String           @unique // e.g. LEAD-1001
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  source            String           // Website, Referral, Cold Call, Exhibition, etc.
  priority          LeadPriority     @default(MEDIUM)
  status            LeadStatus       @default(NEW)
  requirement       String
  expectedValue     Float            @default(0) // In INR
  assignedToId      String?
  assignedTo        User?            @relation("LeadsAssigned", fields: [assignedToId], references: [id])
  createdById       String
  createdBy         User             @relation("LeadsCreated", fields: [createdById], references: [id])
  nextFollowUpDate  DateTime?
  lostReason        String?
  holdReason        String?
  hasContacted      Boolean          @default(false)
  contactedAt       DateTime?
  isDeleted         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  assignments       LeadAssignment[]
  activities        LeadActivity[]
  tasks             Task[]
  followups         FollowUp[]
  deals             Deal[]
  fieldCheckins     FieldCheckin[]

  @@index([clientId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@map("leads")
}

model LeadAssignment {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User     @relation("AssignedToUser", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User     @relation("AssignmentsMade", fields: [assignedById], references: [id])
  notes        String?
  createdAt    DateTime @default(now())

  @@index([leadId])
  @@index([assignedToId])
  @@map("lead_assignments")
}

model LeadActivity {
  id              String       @id @default(uuid())
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  type            ActivityType @default(NOTE)
  title           String
  description     String?
  previousStatus  String?
  newStatus       String?
  remarks         String?
  durationMinutes Int?
  outcome         String?
  createdAt       DateTime     @default(now())

  @@index([leadId])
  @@index([userId])
  @@map("lead_activities")
}

model Task {
  id                    String        @id @default(uuid())
  taskId                String        @unique // e.g. TSK-1001
  title                 String
  description           String
  priority              TaskPriority  @default(MEDIUM)
  status                TaskStatus    @default(NOT_STARTED)
  assignedToId          String
  assignedTo            User          @relation("TasksAssignedTo", fields: [assignedToId], references: [id])
  assignedById          String
  assignedBy            User          @relation("TasksCreatedBy", fields: [assignedById], references: [id])
  clientId              String?
  client                Client?       @relation(fields: [clientId], references: [id])
  leadId                String?
  lead                  Lead?         @relation(fields: [leadId], references: [id])
  startDate             DateTime?     @default(now())
  dueDate               DateTime
  completedAt           DateTime?
  completionEvidence    String?
  evidenceAttachment    String?
  managerReviewRemarks  String?
  reviewedById          String?
  reviewedBy            User?         @relation("TasksReviewed", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  isDeleted             Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  updates               TaskUpdate[]

  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
  @@map("tasks")
}

model TaskUpdate {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // CREATED, STATUS_UPDATED, SUBMITTED_FOR_REVIEW, APPROVED, REJECTED, COMMENTED
  remarks    String?
  attachment String?
  createdAt  DateTime @default(now())

  @@index([taskId])
  @@map("task_updates")
}

model FollowUp {
  id               String         @id @default(uuid())
  followupId       String         @unique // e.g. FOL-1001
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  scheduledDate    DateTime
  status           FollowUpStatus @default(SCHEDULED)
  type             String         @default("Call") // Call, Meeting, Video Conference, Field Visit, Email
  callOutcome      String?
  clientResponse   String?
  discussionNotes  String?
  nextFollowUpDate DateTime?
  completedAt      DateTime?
  isDeleted        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([leadId])
  @@index([clientId])
  @@index([userId])
  @@index([status])
  @@index([scheduledDate])
  @@map("followups")
}

model Deal {
  id          String    @id @default(uuid())
  dealId      String    @unique // e.g. DEL-1001
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  currency    String    @default("INR")
  stage       String    // Negotiation, Won, Lost
  closeDate   DateTime?
  closedById  String?
  closedBy    User?     @relation("DealsClosedBy", fields: [closedById], references: [id])
  wonReason   String?
  lostReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([clientId])
  @@map("deals")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(ANNOUNCEMENT)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  action     String   // CLIENT_CREATED, LEAD_ASSIGNED, etc.
  entityType String   // CLIENT, LEAD, TASK, FOLLOWUP, DEAL, USER
  entityId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@map("audit_logs")
}

model FieldCheckin {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  locationName String
  address      String?
  latitude     Float?
  longitude    Float?
  photoUrl     String   // base64 or uploaded image file path
  notes        String?
  checkinTime  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([checkinTime])
  @@map("field_checkins")
}

